# ==========================================
# REDLINE PAID SCRIMS — ENVIRONMENT TEMPLATE
# ==========================================

# Application URL (Auto-injected in AI Studio / set to your Vercel URL in production)
APP_URL="https://redline-scrims.vercel.app"

# ------------------------------------------
# Firebase Client SDK Configuration (Public)
# ------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="redline-scrims.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="redline-scrims"
VITE_FIREBASE_STORAGE_BUCKET="redline-scrims.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ------------------------------------------
# Firebase Admin SDK (Server / Vercel Functions ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="redline-scrims"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@redline-scrims.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------
# Launch Feature Flags (Defaults adhere strictly to safe launch constraints)
# ------------------------------------------
VITE_FREE_TOURNAMENTS_ENABLED="true"
VITE_PAID_TOURNAMENTS_ENABLED="false"
VITE_PAYMENTS_ENABLED="false"
VITE_CASH_WALLET_ENABLED="false"
VITE_AUTOMATED_PAYOUTS_ENABLED="false"
VITE_SMS_OTP_ENABLED="false"
VITE_WHATSAPP_NOTIFICATIONS_ENABLED="false"
VITE_SMS_NOTIFICATIONS_ENABLED="false"
VITE_IN_APP_NOTIFICATIONS_ENABLED="true"
VITE_REFERRALS_ENABLED="true"
VITE_PUBLIC_REGISTRATION_ENABLED="true"

# ------------------------------------------
# Optional Gemini AI API Key
# ------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
